{
  "name": "osrs-hiscores",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix workers run dev --",
    "test": "npm --prefix workers test && node --test scripts/*.test.mjs",
    "deploy": "node scripts/prepare-history-db.mjs && npm --prefix workers exec -- wrangler d1 migrations apply osrs-hiscores-history --remote --config workers/wrangler.toml && npm --prefix workers run deploy",
    "check": "node scripts/check.mjs",
    "calibrate": "node scripts/calibrate-rates.mjs",
    "capacity": "node scripts/benchmark-capacity.mjs",
    "build": "vite build",
    "build:pages": "node scripts/prepare-pages.mjs"
  },
  "devDependencies": {
    "vite": "^7.3.8"
  }
}
